--!nonstrict
local Motion = require(game.ReplicatedStorage.Shared.Game.MapFeatures.CarryMotion)
return function()
	describe("Course support delta", function()
		it("includes vertical slide without changing avatar orientation", function()
			local delta = Motion.delta(CFrame.identity, CFrame.new(1, 2, 0), Vector3.new(4, 3, 0), 4)
			expect((delta - Vector3.new(1, 2, 0)).Magnitude < 1e-6).to.equal(true)
		end)
		it("carries an offset rider through a spin", function()
			local delta = Motion.delta(CFrame.identity, CFrame.Angles(0, math.pi / 2, 0), Vector3.new(2, 3, 0), 4)
			expect((delta - Vector3.new(-2, 0, -2)).Magnitude < 1e-5).to.equal(true)
		end)
		it("carries an offset rider vertically on a rocking deck", function()
			local delta = Motion.delta(CFrame.identity, CFrame.Angles(0, 0, math.pi / 6), Vector3.new(2, 0, 0), 4)
			expect(math.abs(delta.Y - 1) < 1e-5).to.equal(true)
		end)
		it("rejects a teleport instead of dragging riders across the map", function()
			expect(Motion.delta(CFrame.identity, CFrame.new(100, 0, 0), Vector3.zero, 4)).to.equal(nil)
		end)
	end)
end

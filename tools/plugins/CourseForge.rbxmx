		Support = { p = v(0, -4.7033, 0), a = v(0, -1, 0) },
		SidePositiveX = { p = v(18.3634, 4.7031, 0), a = v(1, 0, 0) },
		SideNegativeX = { p = v(-18.6361, 4.7031, 0), a = v(-1, 0, 0) },
	},
}
SOCKETS.box_012 = {
	Role = "RampConnector",
	Kind = "Surface",
	Size = v(51.172, 53.8566, 55.442),
	ForwardAxis = "X",
	Heading = -90,
	Sockets = {
		Entry = { p = v(-24.1787, 26.927, 0), a = v(-1, 0, 0) },

local CONTAINER_NAMES = {
	"battle_stadium",
	"Battle_Arena",
	"battle_arena",
	"BattleArena",
	"BattleStadium",
	"AssetPack",
}

local function v(x: number, y: number, z: number): Vector3
	return Vector3.new(x, y, z)
end


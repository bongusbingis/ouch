-- Name: ArenaReadinessGate.spec.luau
-- Author: Jack C.
-- Description: Spec for the arena readiness gate: release on a full ready roster, release at the deadline, never opening with nobody ready, and tolerance of duplicate arrivals.
-- Created: 2026-08-24

--!strict

local T = require(script.Parent.TestKit)
local ArenaReadinessGate = require(script.Parent.Parent.Game.Matchmaking.ArenaReadinessGate)

T.describe("ArenaReadinessGate", function()
	T.it("releases a matched roster as soon as every expected player is ready", function()
		local gate = ArenaReadinessGate.new("Matched", 2, 20)
		ArenaReadinessGate.arrive(gate, 1)
		ArenaReadinessGate.arrive(gate, 2)
		ArenaReadinessGate.markReady(gate, 1)
		T.expect(not ArenaReadinessGate.evaluate(gate, 5)):toBeTruthy()
		ArenaReadinessGate.markReady(gate, 2)
		local released, reason = ArenaReadinessGate.evaluate(gate, 6)
		T.expect(released):toBeTruthy()
		T.expect(reason):toEqual("all_ready")
	end)

	T.it("releases ready players at the deadline without waiting for missing arrivals", function()
		local gate = ArenaReadinessGate.new("Matched", 20, 120)
		ArenaReadinessGate.arrive(gate, 1)
		ArenaReadinessGate.markReady(gate, 1)
		T.expect(not ArenaReadinessGate.evaluate(gate, 119.99)):toBeTruthy()
		local released, reason = ArenaReadinessGate.evaluate(gate, 120)
		T.expect(released):toBeTruthy()
		T.expect(reason):toEqual("deadline")
	end)

	T.it("never opens an invisible vote when nobody is ready", function()
		local gate = ArenaReadinessGate.new("Matched", 4, 20)
		ArenaReadinessGate.arrive(gate, 1)
		T.expect(not ArenaReadinessGate.evaluate(gate, 20)):toBeTruthy()
		T.expect(not ArenaReadinessGate.evaluate(gate, 200)):toBeTruthy()
		ArenaReadinessGate.markReady(gate, 1)
		local released, reason = ArenaReadinessGate.evaluate(gate, 200)
		T.expect(released):toBeTruthy()
		T.expect(reason):toEqual("deadline")
	end)

	T.it("opens a direct session once its client is ready", function()
		local gate = ArenaReadinessGate.new("Direct", 1, 0)
		ArenaReadinessGate.arrive(gate, 7)
		ArenaReadinessGate.markReady(gate, 7)
		local released, reason = ArenaReadinessGate.evaluate(gate, 0)
		T.expect(released):toBeTruthy()
		T.expect(reason):toEqual("all_ready")
	end)

	T.it("removes departed arrivals and readiness without releasing twice", function()
		local gate = ArenaReadinessGate.new("Matched", 2, 20)
		ArenaReadinessGate.arrive(gate, 1)
		ArenaReadinessGate.arrive(gate, 2)
		ArenaReadinessGate.markReady(gate, 1)
		ArenaReadinessGate.leave(gate, 1)
		local snapshot = ArenaReadinessGate.snapshot(gate)
		T.expect(snapshot.arrivedPlayerCount):toEqual(1)
		T.expect(snapshot.readyPlayerCount):toEqual(0)
		ArenaReadinessGate.markReady(gate, 2)
		T.expect(ArenaReadinessGate.evaluate(gate, 20)):toBeTruthy()
		T.expect(not ArenaReadinessGate.evaluate(gate, 21)):toBeTruthy()
	end)

	T.it("ignores duplicate arrival and ready acknowledgements", function()
		local gate = ArenaReadinessGate.new("Matched", 2, 20)
		T.expect(ArenaReadinessGate.arrive(gate, 1)):toBeTruthy()
		T.expect(not ArenaReadinessGate.arrive(gate, 1)):toBeTruthy()
		T.expect(ArenaReadinessGate.markReady(gate, 1)):toBeTruthy()
		T.expect(not ArenaReadinessGate.markReady(gate, 1)):toBeTruthy()
		local snapshot = ArenaReadinessGate.snapshot(gate)
		T.expect(snapshot.arrivedPlayerCount):toEqual(1)
		T.expect(snapshot.readyPlayerCount):toEqual(1)
	end)
end)

return true

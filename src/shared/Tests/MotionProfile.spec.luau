--!strict
local T = require(script.Parent.TestKit)
local P = require(script.Parent.Parent.Game.MapFeatures.MotionProfile)
T.describe("MotionProfile", function()
	T.it("winds up slowly and strikes eight times faster", function()
		T.expect(P.hammer(0, 1, 2, 0.25, 0)):toBeNear(-1, 1e-8)
		T.expect(P.hammer(2, 1, 2, 0.25, 0)):toBeNear(1, 1e-8)
		T.expect(P.hammer(2.25, 1, 2, 0.25, 0)):toBeNear(-1, 1e-8)
		local _, slow = P.hammer(1, 1, 2, 0.25, 0)
		local _, fast = P.hammer(2.125, 1, 2, 0.25, 0)
		T.expect(-fast / slow):toBeNear(8, 1e-8)
	end)
	T.it("extends holds retracts and rests", function()
		T.expect(P.piston(0, 12, 4, 1, 0)):toBeNear(0, 1e-8)
		T.expect(P.piston(0.8, 12, 4, 1, 0)):toBeNear(12, 1e-8)
		T.expect(P.piston(3, 12, 4, 1, 0)):toBeNear(0, 1e-8)
		T.expect(P.piston(4, 12, 4, 1, 0)):toBeNear(0, 1e-8)
		T.expect(P.piston(0, 12, 4, 1, 0.8)):toBeNear(12, 1e-8)
	end)
	T.it("reports the derivative used by contact shoves", function()
		local h = 1e-5
		local _, rate = P.piston(0.3, 12, 4, 1, 0)
		T.expect(rate):toBeNear((P.piston(0.3 + h, 12, 4, 1, 0) - P.piston(0.3 - h, 12, 4, 1, 0)) / (2 * h), 1e-5)
	end)
	T.it("accelerates relative to the round epoch but preserves ordinary spin", function()
		local angle, speed = P.spin(102, 30, 10, 100, 0)
		T.expect(angle):toBeNear(math.rad(80), 1e-8)
		T.expect(speed):toBeNear(math.rad(50), 1e-8)
		T.expect(P.spin(2, 30, 0, 100, 0)):toBeNear(math.rad(60), 1e-8)
	end)
end)
return true
